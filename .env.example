# SMTP-Zugang für die Auftragsbestätigung an den Kunden (/api/schaerfauftrag)
# Beispiel für web.de / GMX / Gmail o.ä. – Werte beim jeweiligen Anbieter erzeugen.
SMTP_HOST=smtp.web.de
SMTP_PORT=587
SMTP_USER=hartmann-schaerfservice@web.de
SMTP_PASS=dein-app-passwort
# Absenderadresse (optional, Standard = SMTP_USER)
MAIL_FROM=hartmann-schaerfservice@web.de
